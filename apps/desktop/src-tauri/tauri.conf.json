{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencow",
  "version": "0.1.0",
  "identifier": "cn.opencow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "opencow",
        "create": false,
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "dataDirectory": "dev-webview"
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
