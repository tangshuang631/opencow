{
  "name": "opencow",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows desktop AI assistant based on OpenClaw.",
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "desktop:dev": "npm --workspace apps/desktop run tauri:dev",
    "build": "npm --workspace apps/desktop run build",
    "test": "npm --workspaces --if-present run test",
    "test:unit": "npm --workspace apps/desktop run test:unit",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:health": "node scripts/check-health.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
